# 本程序不会自动读取 .env；请在启动进程或反向代理服务环境中设置这些变量。
PPO_HOST=0.0.0.0
PPO_PORT=17654
PPO_PORT_AUTO_INCREMENT=true

# 公网反向代理：默认仅信任本机代理；代理必须覆盖而非原样追加客户端传入的这些请求头。
PPO_TRUST_PROXY=true
PPO_TRUSTED_PROXIES=127.0.0.1
PPO_PUBLIC_BASE_URL=

# 私有 GitHub 仓库不能匿名检查更新。正式发布建议填写公开 JSON 清单地址：
# {"version":"1.0.4","url":"https://公开下载地址"}
PPO_UPDATE_MANIFEST_URL=
# 仅限开发者本机临时使用，切勿写入源码、安装包或公开环境。
PPO_GITHUB_TOKEN=

# 可选：首次启动时初始化远程 Admin 密码，至少 9 位；随后可在 Admin 页面修改。
PPO_ADMIN_PASSWORD=
PPO_ADMIN_SESSION_HOURS=12
PPO_ADMIN_LOGIN_ATTEMPTS=5
PPO_ADMIN_LOGIN_WINDOW_MS=900000

PPO_QUEUE_MAX=10
PPO_IP_SUBMISSIONS_PER_MINUTE=10
PPO_IP_PER_MINUTE=2
PPO_IP_PER_DAY=30
PPO_DEVICE_COOLDOWN_MS=25000
PPO_FEEDBACK_PER_HOUR=3
PPO_FEEDBACK_PER_DAY=10
PPO_FEEDBACK_ATTACHMENT_MAX_FILES=3
PPO_FEEDBACK_ATTACHMENT_MAX_FILE_BYTES=5242880
PPO_FEEDBACK_ATTACHMENT_MAX_TOTAL_BYTES=10485760

# 可选：短信结果通知也可在 Admin 页面配置。环境变量 Token 优先且不会被页面覆盖。
SMS_API_URL=https://app.fanxiaolong.uk/api/v1/sms/messages
SMS_API_TOKEN=
PPO_SMS_TIMEOUT_MS=8000
PPO_SMS_MAX_ATTEMPTS=2

# 仅公网 IP 异步定位；不发送车牌、证件或反馈内容。
PPO_IP_GEO_ENABLED=true
PPO_IP_GEO_ENDPOINT=https://ipwho.is
PPO_IP_GEO_TIMEOUT_MS=3000
PPO_IP_GEO_CACHE_DAYS=30

PPO_API_KEYS=
PPO_CORS_ORIGINS=
